# Copy to .env.gateway and .env.agent and fill in. Never commit either.
#
# ---- .env.gateway: the merchant's side. The agent never sees this file. ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
COUNTERSIGN_AGENT_TOKEN=
COUNTERSIGN_OPERATOR_TOKEN=
COUNTERSIGN_DB=countersign.db
COUNTERSIGN_AUTO_MAX=25.00
COUNTERSIGN_HARD_MAX=200.00
COUNTERSIGN_DAILY_AUTO_CAP=100.00
#
# ---- .env.agent: everything the agent process is given. ----
# COUNTERSIGN_URL=http://127.0.0.1:8787
# COUNTERSIGN_AGENT_TOKEN=   (same value as above)
# ANTHROPIC_API_KEY=